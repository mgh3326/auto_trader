[Unit]
Description=Run auto_trader kickoff lane event b0x-nudge-kr

[Timer]
# Persistent=false: a missed kickoff must never be replayed after its window.
OnCalendar=Mon..Fri *-*-* 09:05:00 Asia/Seoul
Persistent=false
RandomizedDelaySec=0
Unit=job-kickoff-b0x-nudge-kr.service

[Install]
WantedBy=timers.target
