[Unit]
Description=auto_trader KR investor-flow snapshots
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/root/at-run
Environment=AT_RUNTIME_ENV_FILE=/root/at-secrets/.env.api
ExecStart=/root/at-run/ops/ncp/bin/at-job.sh scripts.build_investor_flow_snapshots --market kr --days 5 --batch-size 100 --concurrency 4 --all --commit
TimeoutStartSec=1830
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
