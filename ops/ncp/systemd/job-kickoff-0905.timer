[Unit]
Description=Run auto_trader kickoff lane event 0905

[Timer]
# Persistent=false: a missed kickoff must never be replayed after its market window.
OnCalendar=Mon..Fri *-*-* 09:05:00 Asia/Seoul
Persistent=false
RandomizedDelaySec=0
Unit=job-kickoff-0905.service

[Install]
WantedBy=timers.target
