[Unit]
Description=auto_trader US market valuation snapshots
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/root/at-run
Environment=AT_RUNTIME_ENV_FILE=/root/at-secrets/.env.api
Environment=AT_JOB_COMMIT_ENV=MARKET_VALUATION_SNAPSHOTS_COMMIT_ENABLED
ExecStart=/root/at-run/ops/ncp/bin/at-job.sh scripts.build_market_valuation_snapshots --market us --batch-size 100 --concurrency 4 --all --common-stocks-only
TimeoutStartSec=10830
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
