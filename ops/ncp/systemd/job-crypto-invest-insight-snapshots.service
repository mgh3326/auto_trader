[Unit]
Description=auto_trader crypto invest insight snapshots
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/root/at-run
Environment=AT_RUNTIME_ENV_FILE=/root/at-secrets/.env.api
ExecStart=/root/at-run/ops/ncp/bin/at-job.sh scripts.build_crypto_insight_snapshots
TimeoutStartSec=3630
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
