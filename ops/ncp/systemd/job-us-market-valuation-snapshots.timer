[Unit]
Description=Run auto_trader US market valuation snapshots at the Prefect schedule

[Timer]
# PrefectCron: 30 8 * * 2-6
# PrefectTimezone: Asia/Seoul
OnCalendar=Tue..Sat *-*-* 08:30:00 Asia/Seoul
Persistent=false
RandomizedDelaySec=0
Unit=job-us-market-valuation-snapshots.service

[Install]
WantedBy=timers.target
