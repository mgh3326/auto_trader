+[Unit]
Description=Run auto_trader kickoff lane event nxt-open

[Timer]
# Persistent=false: a missed kickoff must never be replayed after its market window.
OnCalendar=Mon..Fri *-*-* 07:55:00 Asia/Seoul
Persistent=false
RandomizedDelaySec=0
Unit=job-kickoff-nxt-open.service

[Install]
WantedBy=timers.target
