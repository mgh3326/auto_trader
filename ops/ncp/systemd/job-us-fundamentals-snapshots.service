[Unit]
Description=auto_trader US fundamentals snapshots
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/root/at-run
Environment=AT_RUNTIME_ENV_FILE=/root/at-secrets/.env.api
Environment=AT_JOB_COMMIT_ENV=MARKET_VALUATION_SNAPSHOTS_COMMIT_ENABLED
ExecStart=/root/at-run/ops/ncp/bin/at-job.sh scripts.build_us_fundamentals_snapshots --concurrency 4 --all --with-dividends
TimeoutStartSec=10830
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
