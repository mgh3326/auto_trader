[Unit]
Description=auto_trader durable fill-event operator handoff
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/root/at-run
EnvironmentFile=/root/at-secrets/.env.fill-handoff
ExecStart=/bin/sh -ec 'image="$$(cat /root/at-run/deployed-digest)"; exec /usr/bin/docker run --rm --network host --env-file /root/at-secrets/.env.fill-handoff -v "$${FILL_HANDOFF_STATE_DIR:-/var/lib/fill-event-handoff}:$${FILL_HANDOFF_STATE_DIR:-/var/lib/fill-event-handoff}" "$$image" /app/.venv/bin/python -m scripts.fill_event_handoff'
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
