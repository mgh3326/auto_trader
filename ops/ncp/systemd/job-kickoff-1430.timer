+[Unit]
Description=Run auto_trader kickoff lane event 1430

[Timer]
# Persistent=false: a missed kickoff must never be replayed after its market window.
OnCalendar=Mon..Fri *-*-* 14:30:00 Asia/Seoul
Persistent=false
RandomizedDelaySec=0
Unit=job-kickoff-1430.service

[Install]
WantedBy=timers.target
