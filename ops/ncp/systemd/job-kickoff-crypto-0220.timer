[Unit]
Description=Run auto_trader kickoff lane event crypto-0220

[Timer]
# Persistent=false: a missed kickoff must never be replayed after its market window.
OnCalendar=*-*-* 02:20:00 Asia/Seoul
Persistent=false
RandomizedDelaySec=0
Unit=job-kickoff-crypto-0220.service

[Install]
WantedBy=timers.target
