[Unit]
Description=Run auto_trader KR fundamentals snapshots at the Prefect schedule

[Timer]
# PrefectCron: 0 18 * * *
# PrefectTimezone: Asia/Seoul
OnCalendar=*-*-* 18:00:00 Asia/Seoul
Persistent=false
RandomizedDelaySec=0
Unit=job-kr-fundamentals-snapshots.service

[Install]
WantedBy=timers.target
