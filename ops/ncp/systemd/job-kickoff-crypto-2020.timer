[Unit]
Description=Run auto_trader kickoff lane event crypto-2020

[Timer]
# Persistent=false: a missed kickoff must never be replayed after its market window.
OnCalendar=*-*-* 20:20:00 Asia/Seoul
Persistent=false
RandomizedDelaySec=0
Unit=job-kickoff-crypto-2020.service

[Install]
WantedBy=timers.target
