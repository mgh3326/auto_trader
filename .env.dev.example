BINANCE_DEMO_SCALPING_ENABLED=false
BINANCE_DEMO_STRATEGY_LOOP_ENABLED=false
BINANCE_DEMO_RESERVATION_RECONCILE_ENABLED=false
BINANCE_DEMO_RESERVATION_RECONCILE_CONFIRM=false

# Toss live API
TOSS_API_ENABLED=false
TOSS_API_CLIENT_ID=DEV_PLACEHOLDER_TOSS_API_CLIENT_ID
TOSS_API_CLIENT_SECRET=DEV_PLACEHOLDER_TOSS_API_CLIENT_SECRET
TOSS_LIVE_ORDER_MUTATIONS_ENABLED=false
TOSS_MANUAL_ACTIVITY_SWEEP_ENABLED=false
