ORDER_APPROVAL_HASH_MODE=off

# NHPLUG mock/read-only and separately gated live quote collection
NHPLUG_MOCK_ENABLED=false
NHPLUG_APP_KEY=DEV_PLACEHOLDER_NHPLUG_APP_KEY
NHPLUG_APP_SECRET=DEV_PLACEHOLDER_NHPLUG_APP_SECRET
NHPLUG_MOCK_ACCOUNT_NO=DEV_PLACEHOLDER_NHPLUG_MOCK_ACCOUNT_NO
NHPLUG_LIVE_QUOTES_ENABLED=false
NHPLUG_LIVE_APP_KEY=DEV_PLACEHOLDER_NHPLUG_LIVE_APP_KEY
NHPLUG_LIVE_APP_SECRET=DEV_PLACEHOLDER_NHPLUG_LIVE_APP_SECRET

# Other external-data credentials are also inert sentinels in the portable kit.
FINNHUB_API_KEY=DEV_PLACEHOLDER_FINNHUB_API_KEY
OPENDART_API_KEY=DEV_PLACEHOLDER_OPENDART_API_KEY
KRX_MEMBER_ID=DEV_PLACEHOLDER_KRX_MEMBER_ID
KRX_PASSWORD=DEV_PLACEHOLDER_KRX_PASSWORD

