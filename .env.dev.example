# Copy to .env.dev before using the portable development kit.
#
# The compose project name must keep the `at-dev-<suffix>` form.  Choose a
# unique suffix per checkout/user; Docker prefixes every container, volume,
# and network with it.  The two host ports are intentionally outside the
# production defaults and are loopback-only.
COMPOSE_PROJECT_NAME=at-dev-local
DEV_PG_BIND_HOST=127.0.0.1
DEV_PG_PORT=55432
DEV_PG_USER=atdev
DEV_PG_PASSWORD=atdev-local-password
DEV_PG_DATABASE=auto_trader_dev
DEV_REDIS_BIND_HOST=127.0.0.1
DEV_REDIS_PORT=56379
DEV_UP_TIMEOUT_SECONDS=60
DEV_HEALTH_TIMEOUT_SECONDS=30
DEV_API_PORT=58080

# These runtime URLs are convenient for direct `uv run` use.  Make targets
# derive the same URLs from the DEV_* fields above, so keep this pair aligned
# when invoking commands outside Make after changing either host port.
DATABASE_URL=postgresql+asyncpg://atdev:atdev-local-password@127.0.0.1:55432/auto_trader_dev
REDIS_URL=redis://127.0.0.1:56379/0

# Core application settings required at import/startup.  They are deliberately
# non-production development values; do not reuse this file for any deployed
# environment.
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=DevOnlySecretKeyForDevelopment0123456789
DOCS_ENABLED=false
SENTRY_DSN=
SENTRY_ENABLE_LOG_EVENTS=false
SENTRY_SEND_DEFAULT_PII=false
SENTRY_MCP_INCLUDE_PROMPTS=false
MCP_PROFILE=default
MCP_AUTH_TOKEN=DEV_PLACEHOLDER_MCP_AUTH_TOKEN
MCP_TRADINGCODEX_EXECUTION_AUTH_TOKEN=DEV_PLACEHOLDER_MCP_TRADINGCODEX_EXECUTION_AUTH_TOKEN

# Every broker credential is a fixed sentinel, never an empty slot that can
# accidentally inherit a host secret.  The guard in tests/test_dev_kit.py
# rejects real-looking replacement values and requires all execution gates to
# stay false.

# KIS (live and mock)
KIS_APP_KEY=DEV_PLACEHOLDER_KIS_APP_KEY
KIS_APP_SECRET=DEV_PLACEHOLDER_KIS_APP_SECRET
KIS_ACCESS_TOKEN=DEV_PLACEHOLDER_KIS_ACCESS_TOKEN
KIS_ACCOUNT_NO=DEV_PLACEHOLDER_KIS_ACCOUNT_NO
KIS_WS_HTS_ID=DEV_PLACEHOLDER_KIS_WS_HTS_ID
KIS_BASE_URL=http://127.0.0.1:9
KIS_MOCK_ENABLED=false
KIS_MOCK_APP_KEY=DEV_PLACEHOLDER_KIS_MOCK_APP_KEY
KIS_MOCK_APP_SECRET=DEV_PLACEHOLDER_KIS_MOCK_APP_SECRET
KIS_MOCK_ACCESS_TOKEN=DEV_PLACEHOLDER_KIS_MOCK_ACCESS_TOKEN
KIS_MOCK_ACCOUNT_NO=DEV_PLACEHOLDER_KIS_MOCK_ACCOUNT_NO
KIS_MOCK_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_MOCK_SCALPING_ENABLED=false
KIS_MOCK_SCALPING_WS_ENABLED=false
KIS_MOCK_SCALPING_WS_CONFIRM=false
KIS_MOCK_RECONCILE_ON_EXECUTION_ENABLED=false
KIS_MOCK_RECONCILE_PERIODIC_ENABLED=false
KIS_MOCK_OPEN_ORDER_PROBE_ENABLED=false
KIS_MOCK_OVERSEAS_SMOKE_ENABLED=false
KIS_MOCK_US_CASH_PROBE_ENABLED=false
KIS_LIVE_AUTO_RECONCILE_ENABLED=false
KIS_LIVE_AUTO_RECONCILE_SAFETY_REVIEW_PASSED=false

# Kiwoom (mock and read-only live market-data lanes)
KIWOOM_MOCK_ENABLED=false
KIWOOM_MOCK_APP_KEY=DEV_PLACEHOLDER_KIWOOM_MOCK_APP_KEY
KIWOOM_MOCK_APP_SECRET=DEV_PLACEHOLDER_KIWOOM_MOCK_APP_SECRET
KIWOOM_MOCK_ACCESS_TOKEN=DEV_PLACEHOLDER_KIWOOM_MOCK_ACCESS_TOKEN
KIWOOM_MOCK_ACCOUNT_NO=DEV_PLACEHOLDER_KIWOOM_MOCK_ACCOUNT_NO
KIWOOM_MOCK_BASE_URL=https://mockapi.kiwoom.com
KIWOOM_MOCK_US_ENABLED=false
KIWOOM_MOCK_US_APP_KEY=DEV_PLACEHOLDER_KIWOOM_MOCK_US_APP_KEY
KIWOOM_MOCK_US_APP_SECRET=DEV_PLACEHOLDER_KIWOOM_MOCK_US_APP_SECRET
KIWOOM_MOCK_US_ACCOUNT_NO=DEV_PLACEHOLDER_KIWOOM_MOCK_US_ACCOUNT_NO
KIWOOM_LIVE_MARKETDATA_ENABLED=false
KIWOOM_LIVE_APP_KEY=DEV_PLACEHOLDER_KIWOOM_LIVE_APP_KEY
KIWOOM_LIVE_APP_SECRET=DEV_PLACEHOLDER_KIWOOM_LIVE_APP_SECRET
KIWOOM_LIVE_BASE_URL=https://api.kiwoom.com
KIWOOM_STAGE2_COLLECT_ENABLED=false

# Upbit
UPBIT_ACCESS_KEY=DEV_PLACEHOLDER_UPBIT_ACCESS_KEY
UPBIT_SECRET_KEY=DEV_PLACEHOLDER_UPBIT_SECRET_KEY

# Alpaca paper/data lanes
ALPACA_PAPER_API_KEY=DEV_PLACEHOLDER_ALPACA_PAPER_API_KEY
