ALPACA_DATA_API_SECRET_KEY=DEV_PLACEHOLDER_ALPACA_DATA_API_SECRET_KEY
ALPACA_PAPER_DEFAULT_TOOLS_ENABLED=false
ALPACA_PAPER_CRYPTO_ENABLED=false
ALPACA_PAPER_AUTOMATED_SUBMIT_ENABLED=false
ALPACA_US_COLLECT_ENABLED=false

# Binance demo lanes (all live/testnet paths remain blocked in application code)
BINANCE_DEMO_API_KEY=DEV_PLACEHOLDER_BINANCE_DEMO_API_KEY
BINANCE_DEMO_API_SECRET=DEV_PLACEHOLDER_BINANCE_DEMO_API_SECRET
BINANCE_SPOT_DEMO_API_KEY=DEV_PLACEHOLDER_BINANCE_SPOT_DEMO_API_KEY
