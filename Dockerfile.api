# syntax=docker/dockerfile:1.29

# ==============================================================================
# STAGE 1: 'builder' - 의존성 설치를 전담하는 스테이지
# 이 스테이지는 각 아키텍처(amd64, arm64)에 맞게 의존성을 설치하는 역할만 합니다.
# ==============================================================================
# Build dependencies for the TARGET platform (not the build host)
FROM --platform=$TARGETPLATFORM python:3.13-slim AS builder

# UV 설치
RUN pip install --upgrade pip && pip install uv

WORKDIR /app

# 프로젝트 소스 없이 잠긴 의존성만 설치합니다.
COPY pyproject.toml uv.lock ./

# UV 캐시를 활용하여 빌드 속도 향상
# 가장 무거운 작업인 의존성 설치를 이 단계에서 실행합니다.
RUN --mount=type=cache,target=/root/.cache/uv \
    PYTHONHASHSEED=0 SOURCE_DATE_EPOCH=0 uv sync --frozen --no-install-project --no-dev --compile-bytecode

# ==============================================================================
# STAGE 1b (optional): frontend-builder - builds the React/Vite SPA
# Toggle with: --build-arg ENABLE_FRONTEND_BUILD=1
# ==============================================================================
FROM --platform=$BUILDPLATFORM node:26-alpine AS frontend-builder

ARG ENABLE_FRONTEND_BUILD=0

WORKDIR /build

COPY frontend/invest/package.json frontend/invest/package-lock.json ./
RUN if [ "$ENABLE_FRONTEND_BUILD" = "1" ]; then npm ci; fi

COPY frontend/invest/ ./
RUN if [ "$ENABLE_FRONTEND_BUILD" = "1" ]; then npm run build; else mkdir -p dist && echo '<!-- frontend build disabled -->' > dist/index.html; fi

# ==============================================================================
# STAGE 2: 'final' - 최종 실행 이미지를 만드는 스테이지
# 가볍고 깨끗한 상태에서 시작합니다.
# ==============================================================================
FROM python:3.13-slim AS final

# 환경 변수 설정
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# 필수 OS 패키지 설치
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 비루트 유저 생성
RUN useradd -u 10001 -m appuser && \
    mkdir -m 755 /app/tmp && \
    chown appuser:appuser /app /app/tmp

# ✨ 가장 중요한 부분 ✨
# 'builder' 스테이지에서 설치 완료된 .venv를 그대로 복사해옵니다.
# UV는 .venv에 의존성을 설치하므로 이를 복사합니다.
COPY --chown=appuser:appuser --from=builder /app/.venv /app/.venv

# 앱 소스 코드 복사
COPY --chown=appuser:appuser app/ ./app/
COPY --chown=appuser:appuser research_contracts/ ./research_contracts/
# scripts/binance_demo_strategy_loop.py and scripts/binance_trend_demo.py import
# research.nautilus_scalping.rob974_features through their strategy-loop modules.
# Ship that package, never the rest of research/ (a namespace package: no
# __init__.py chain). The retired H5 runner (hk 6457) no longer needs it on its own.
COPY --chown=appuser:appuser research/nautilus_scalping/ ./research/nautilus_scalping/
# The explicit ROB-1474 paper consumer builds frozen lists from mounted local
# bars. Include its pure research dependency closure, never cached datasets.
COPY --chown=appuser:appuser research/stock_selection/__init__.py research/stock_selection/forward.py research/stock_selection/dataset.py research/stock_selection/io.py research/stock_selection/models.py ./research/stock_selection/
COPY --chown=appuser:appuser research/data_plane/__init__.py research/data_plane/calendars.py research/data_plane/contract.py ./research/data_plane/
COPY --chown=appuser:appuser research/crypto_universe/__init__.py research/crypto_universe/universe.py research/crypto_universe/public_http.py ./research/crypto_universe/
# hk 6036: the intraday shadow recorder imports the hash-pinned hk 6035 rules, their
# allowlisted public GET code and the frozen selection. No cached datasets.
COPY --chown=appuser:appuser research/upbit_intraday/__init__.py research/upbit_intraday/rules.py research/upbit_intraday/fetch.py research/upbit_intraday/public_http.py research/upbit_intraday/frozen_selection.json ./research/upbit_intraday/
COPY --chown=appuser:appuser alembic/ ./alembic/
COPY --chown=appuser:appuser alembic.ini pyproject.toml README.md ./
# The pi runs the Upbit/KIS websocket monitors from this image (at-upbit-ws /
# at-kis-ws, deploy/shiftgate/pi); the script lives at the repo root.
COPY --chown=appuser:appuser websocket_monitor.py ./
COPY --chown=appuser:appuser scripts/ ./scripts/
COPY --chown=appuser:appuser static/ ./static/
COPY --chown=appuser:appuser config/ ./config/
COPY --chown=appuser:appuser --from=frontend-builder /build/dist /app/frontend/invest/dist

# 비루트 유저로 전환
USER appuser

# 커밋별 메타데이터는 의존성과 소스 레이어 뒤에 둡니다.
ARG VCS_REF=""
ARG GITHUB_SHA=unknown
ENV GITHUB_SHA=$GITHUB_SHA
RUN printf '%s' "$VCS_REF" > /app/.build-vcs-ref

# 볼륨 마운트 포인트
VOLUME ["/app/tmp"]

# 환경 변수 설정 (가상환경 경로)
ENV PATH="/app/.venv/bin:$PATH"

# 헬스체크 (curl 사용으로 Python subprocess 오버헤드 제거)
HEALTHCHECK --interval=30s --timeout=3s --retries=5 \
    CMD curl -f http://localhost:8000/healthz || exit 1

EXPOSE 8000

# FastAPI 실행
CMD ["python", "-m", "uvicorn", "app.main:api", "--host", "0.0.0.0", "--port", "8000"]
